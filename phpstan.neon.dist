includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # Package config files are published into the app's config directory, so env() is correct here.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/*

